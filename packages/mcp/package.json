{
  "name": "@ai-changeguard/mcp",
  "version": "0.1.0",
  "description": "MCP server: lets AI coding assistants find retiring AI models in your code and test a model switch.",
  "license": "MIT",
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "model-deprecation",
    "migration"
  ],
  "homepage": "https://github.com/Navin-kumar0007/ai-change-guard-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Navin-kumar0007/ai-change-guard-cli.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/Navin-kumar0007/ai-change-guard-cli/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "ai-change-guard-mcp": "./dist/main.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-changeguard/catalog": "0.1.0",
    "@ai-changeguard/llm": "0.1.0",
    "@ai-changeguard/replay": "0.1.0",
    "@ai-changeguard/scanner": "0.1.0",
    "zod": "4.6.7",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}

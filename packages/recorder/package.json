{
  "name": "@ai-changeguard/recorder",
  "version": "0.1.0",
  "description": "Records your app's real AI calls to a JSONL file that ai-change-guard import turns into a golden set.",
  "license": "MIT",
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "model-deprecation",
    "migration"
  ],
  "homepage": "https://github.com/Navin-kumar0007/ai-change-guard-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Navin-kumar0007/ai-change-guard-cli.git",
    "directory": "packages/recorder"
  },
  "bugs": {
    "url": "https://github.com/Navin-kumar0007/ai-change-guard-cli/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "npm run build"
  }
}
